# IMARIXA — Environment Configuration Example
# Copy this file to `.env` for local/serverless use and fill in real values.
# NEVER commit a real `.env` file. It is already listed in .gitignore.

# ---------------------------------------------------------------------------
# FORM BACKEND (choose one)
# Used by the quote form (#quoteForm in index.html / js/main.js) once you
# wire it to a real backend instead of the WhatsApp fallback.
# ---------------------------------------------------------------------------

# Formspree
FORMSPREE_FORM_ID=

# Resend (transactional email)
RESEND_API_KEY=
RESEND_FROM_EMAIL=quotes@imarixa.com
RESEND_TO_EMAIL=info@imarixa.com

# EmailJS (client-side email widget)
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=

# ---------------------------------------------------------------------------
# PAYMENT GATEWAY (server-side / serverless function only — never expose
# secret keys in frontend code or commit them to the repository)
# ---------------------------------------------------------------------------

# Mobile money aggregator (e.g. Selcom, ClickPesa, or similar TZ provider)
PAYMENT_PROVIDER_API_KEY=
PAYMENT_PROVIDER_SECRET=
PAYMENT_WEBHOOK_SECRET=

# Card payments (e.g. Stripe, Flutterwave, DPO)
CARD_GATEWAY_PUBLIC_KEY=
CARD_GATEWAY_SECRET_KEY=

# ---------------------------------------------------------------------------
# GENERAL
# ---------------------------------------------------------------------------
SITE_URL=https://imarixa.com
CONTACT_WHATSAPP=+639667536305
